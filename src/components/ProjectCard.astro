---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import PostMetadata from "./PostMeta.astro";

interface Props {
	entry: CollectionEntry<"projects">;
	url: string;
	class?: string;
	style?: string;
}

const { entry, url, style } = Astro.props;
const className = Astro.props.class;

const {
	title,
	description,
	published,
	updated,
	role,
	techStack = [],
	repoUrl,
	demoUrl,
} = entry.data;
---

<div class:list={["card-base flex flex-col w-full rounded-[var(--radius-large)] overflow-hidden relative border border-black/10 dark:border-white/10 hover:border-[var(--primary)]/30 transition-all min-h-full", className]} style={style}>
    <div class="px-6 md:px-8 py-6 flex flex-col gap-4 h-full">
        <div class="flex flex-row justify-between items-start gap-3">
            <div class="flex-1 min-w-0">
                <a href={url}
                   class="transition group w-full block font-bold mb-1.5 text-2xl text-90 leading-tight
                        hover:text-[var(--primary)] dark:hover:text-[var(--primary)]
                        active:text-[var(--title-active)] dark:active:text-[var(--title-active)]
                ">
                    {title}
                </a>
                {role && <div class="text-sm text-50 font-medium mb-0.5">Role: {role}</div>}
            </div>
        </div>

        <PostMetadata class="mb-1" published={published} updated={updated}></PostMetadata>

        <div class="transition text-75 leading-relaxed">{description || "No description provided."}</div>

        {techStack.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-auto pt-2">
                {techStack.map((tech) => (
                    <div class="px-2.5 py-0.5 rounded-md bg-black/5 dark:bg-white/10 text-[11px] font-semibold text-50 tracking-tight">{tech}</div>
                ))}
            </div>
        )}

        <div class="flex flex-wrap gap-2 pt-1">
            <a href={url} class="btn-regular h-10 px-4 rounded-lg font-bold active:scale-95">View details</a>
            {demoUrl && <a href={demoUrl} class="btn-plain h-10 px-4 rounded-lg font-bold active:scale-95" target="_blank" rel="noreferrer">View docs / demo</a>}
            {repoUrl && <a href={repoUrl} class="btn-plain h-10 px-4 rounded-lg font-bold active:scale-95" target="_blank" rel="noreferrer">View source</a>}
        </div>
    </div>
</div>
