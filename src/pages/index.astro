---
import AchievementCard from "@components/AchievementCard.astro";
import ProjectCard from "@components/ProjectCard.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedAchievements, getSortedProjects } from "@utils/content-utils";
import { url } from "@utils/url-utils";

const achievements = await getSortedAchievements();
const projects = await getSortedProjects();
const recentAchievements = achievements.slice(0, 3);
const featured = projects.slice(0, 4);

const jsonLd = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${Astro.site}#website`,
            "url": Astro.site,
            "name": "Vivek Bhandari",
            "description": "Q.THE.VAR | Web Security & Bug Bounty | CTF Player | AI-Powered Web Security Testing & Automation",
            "publisher": { "@id": `${Astro.site}#person` },
        },
        {
            "@type": "Person",
            "@id": `${Astro.site}#person`,
            "name": "Vivek Bhandari",
            "url": Astro.site,
            "image": `${Astro.site}favicon/favicon-light-192.png`,
            "jobTitle": "Web Security Researcher & Bug Bounty Hunter",
            "description": "Passionate CTF player and Web Security Researcher from Uttarakhand, India with hands-on experience in security research, vulnerability discovery, bug bounty hunting, and open-source tooling.",
            "sameAs": [
                "https://x.com/viveksecurity",
                "https://github.com/vivekbhandarisec",
                "https://www.linkedin.com/in/vivekbhandarisec/",
                "https://www.instagram.com/qthevar",
            ],
        },
    ],
};
---

<MainGridLayout title="Home" description="Q.THE.VAR | Web Security & Bug Bounty | CTF Player | AI-Powered Web Security Testing & Automation">
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="card-base px-6 md:px-9 py-7 rounded-[var(--radius-large)] onload-animation">
        <div class="flex flex-col gap-3">
            <div class="text-sm font-semibold text-[var(--primary)] uppercase tracking-wide">Web Security Researcher & Bug Bounty Hunter</div>
            <h1 class="text-3xl md:text-4xl font-bold text-90 leading-snug">
                Hi, I&apos;m <span class="name-glitch" title="Q.THE.VAR"><span class="name-original">Vivek Bhandari</span><span class="name-phonetic" aria-hidden="true">Q.THE.VAR</span></span>.
            </h1>
            <div class="text-75 md:text-lg">
                I&apos;m a passionate CTF player and Web Security Researcher from Uttarakhand, India, focused on web application security, bug bounty hunting, and offensive security. I enjoy building security tools, discovering vulnerabilities, and participating in CTF competitions.
            </div>
            <div class="flex flex-wrap gap-2 text-sm text-50">
                <div class="px-3 py-1 rounded-lg bg-black/5 dark:bg-white/10 transition">Uttarakhand, India</div>
                <div class="px-3 py-1 rounded-lg bg-black/5 dark:bg-white/10 transition">Web Security</div>
                <div class="px-3 py-1 rounded-lg bg-black/5 dark:bg-white/10 transition">AI-Powered Web Security Testing & Automation</div>
            </div>
            <div class="flex flex-wrap gap-3 pt-2">
                <a href={url("/projects/")} class="btn-regular h-11 px-4 rounded-xl font-bold active:scale-95">View Projects</a>
                <a href={url("/about/")} class="btn-plain h-11 px-4 rounded-xl font-bold active:scale-95">About Me</a>
                <a href={url("/contact/")} class="btn-plain h-11 px-4 rounded-xl font-bold active:scale-95">Get in Touch</a>
            </div>
        </div>
    </div>

    <div class="card-base px-6 md:px-8 py-6 rounded-[var(--radius-large)] mt-4 onload-animation">
        <div class="flex flex-col gap-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div>
                    <div class="text-sm font-semibold text-[var(--primary)] uppercase tracking-wide">Achievements</div>
                    <h2 class="text-2xl font-bold text-90">Recent Competition Highlights</h2>
                    <p class="text-50 mt-1">A few highlights from recent competitions. The rest lives in the full archive.</p>
                </div>
                <a href={url("/achievements/")} class="btn-plain h-10 px-4 rounded-lg font-bold active:scale-95">View all achievements</a>
            </div>
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-4">
                {recentAchievements.map((entry, idx) => (
                    <AchievementCard
                        entry={entry}
                        class="onload-animation"
                        style={`animation-delay: calc(var(--content-delay) + ${idx * 70}ms);`}
                    />
                ))}
            </div>
        </div>
    </div>

    <div class="card-base px-6 md:px-8 py-6 rounded-[var(--radius-large)] mt-4 onload-animation">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-5">
            <div>
                <div class="text-sm font-semibold text-[var(--primary)] uppercase tracking-wide">Projects</div>
                <h2 class="text-2xl font-bold text-90">Featured Projects</h2>
                <p class="text-50 mt-1">A selection of open-source projects I build and maintain.</p>
            </div>
            <a href={url("/projects/")} class="btn-plain h-10 px-4 rounded-lg font-bold active:scale-95">View all projects</a>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
            {featured.map((entry, idx) => (
                <ProjectCard
                        entry={entry}
                        url={url(`/projects/${entry.slug}/`)}
                        class:list="onload-animation"
                        style={`animation-delay: calc(var(--content-delay) + ${idx * 80}ms);`}
                />
            ))}
        </div>
    </div>

    <div class="card-base px-6 md:px-8 py-6 rounded-[var(--radius-large)] mt-4 onload-animation">
        <div class="flex flex-col gap-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div>
                    <div class="text-sm font-semibold text-[var(--primary)] uppercase tracking-wide">Experience</div>
                    <h2 class="text-2xl font-bold text-90">Professional Journey</h2>
                    <p class="text-50 mt-1">Where I&apos;ve applied my skills in real-world environments.</p>
                </div>
                <a href={url("/about/")} class="btn-plain h-10 px-4 rounded-lg font-bold active:scale-95">Full resume</a>
            </div>
            <div class="grid grid-cols-1 gap-4">
                <div class="p-4 rounded-xl bg-[var(--card-bg)] dark:bg-white/5 border border-black/5 dark:border-white/10 transition hover:bg-black/8 dark:hover:bg-white/8">
                    <div class="flex flex-col md:flex-row md:items-start justify-between gap-2">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-bold text-90">Bug Bounty Hunter</h3>
                                <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-medium">HackerOne</span>
                            </div>
                            <div class="text-sm text-[var(--primary)] font-medium mt-1">HackerOne</div>
                            <ul class="text-50 text-sm mt-2 space-y-1 list-disc list-inside">
                                <li>Researching and reporting web application vulnerabilities.</li>
                                <li>Practicing real-world web security testing and vulnerability research.</li>
                            </ul>
                        </div>
                        <div class="text-sm text-50 font-medium whitespace-nowrap">Ongoing</div>
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-[var(--card-bg)] dark:bg-white/5 border border-black/5 dark:border-white/10 transition hover:bg-black/8 dark:hover:bg-white/8">
                    <div class="flex flex-col md:flex-row md:items-start justify-between gap-2">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-bold text-90">Vice President</h3>
                                <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-medium">SHUNYA</span>
                            </div>
                            <div class="text-sm text-[var(--primary)] font-medium mt-1">SHUNYA — Cybersecurity Club</div>
                            <ul class="text-50 text-sm mt-2 space-y-1 list-disc list-inside">
                                <li>Organizing cybersecurity activities, CTFs, and technical learning sessions.</li>
                                <li>Collaborating with students on security research and projects.</li>
                            </ul>
                        </div>
                        <div class="text-sm text-50 font-medium whitespace-nowrap">Ongoing</div>
                    </div>
                </div>
                <div class="p-4 rounded-xl bg-[var(--card-bg)] dark:bg-white/5 border border-black/5 dark:border-white/10 transition hover:bg-black/8 dark:hover:bg-white/8">
                    <div class="flex flex-col md:flex-row md:items-start justify-between gap-2">
                        <div class="flex-1">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h3 class="font-bold text-90">Building Niriksh</h3>
                                <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-medium">Project</span>
                            </div>
                            <div class="text-sm text-[var(--primary)] font-medium mt-1">Personal Project</div>
                            <ul class="text-50 text-sm mt-2 space-y-1 list-disc list-inside">
                                <li>Developing a real-time, ML-based network attack detection tool for security monitoring and analysis.</li>
                            </ul>
                        </div>
                        <div class="text-sm text-50 font-medium whitespace-nowrap">Ongoing</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-base px-6 md:px-8 py-6 rounded-[var(--radius-large)] mt-4 onload-animation">
        <div class="flex flex-col gap-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div>
                    <div class="text-sm font-semibold text-[var(--primary)] uppercase tracking-wide">Education</div>
                    <h2 class="text-2xl font-bold text-90">Academic Background</h2>
                    <p class="text-50 mt-1">My educational journey in tech and computer science.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="p-4 rounded-xl bg-[var(--card-bg)] dark:bg-white/5 border border-black/5 dark:border-white/10 transition hover:bg-black/8 dark:hover:bg-white/8">
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-bold text-90">B.Tech Computer Science & Engineering</h3>
                            <span class="text-xs px-2 py-0.5 rounded-full bg-[var(--primary)]/10 text-[var(--primary)] font-medium">Ongoing</span>
                        </div>
                        <div class="text-sm text-[var(--primary)] font-medium">GBPIET Pauri, Uttarakhand</div>
                        <div class="text-sm text-50 font-medium">2022 – 2026</div>
                        <div class="flex flex-wrap gap-2 text-xs text-50 mt-2">
                            <div class="px-2 py-0.5 rounded-md bg-black/5 dark:bg-white/10 transition">Computer Science</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card-base px-6 md:px-8 py-6 rounded-[var(--radius-large)] mt-4 onload-animation">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div>
                <div class="text-sm font-semibold text-[var(--primary)] uppercase tracking-wide">Collaboration</div>
                <h2 class="text-2xl font-bold text-90">Let&apos;s build together</h2>
                <p class="text-75 mt-1">I&apos;m always open to collaborating on exciting projects.</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <a href="/contact/" class="btn-regular h-11 px-4 rounded-xl font-bold active:scale-95">Contact</a>
                <a href="https://github.com/vivekbhandarisec" class="btn-plain h-11 px-4 rounded-xl font-bold active:scale-95" target="_blank" rel="noreferrer">GitHub</a>
            </div>
        </div>
    </div>
</MainGridLayout>
